---
export interface Props {
  title: string;
  description: string;
  href: string;
  number: string;
  features: string[];
}

const { title, description, href, number, features } = Astro.props;
---

<div class="minimal-card group flex flex-col justify-between p-8">
  <div>
    <!-- Number tag & Clean Title -->
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs font-semibold text-brand-accent tracking-wider">
        /{number}
      </span>
      <svg class="h-4 w-4 text-brand-text-dim group-hover:text-brand-accent group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </div>

    <h3 class="mt-6 font-display text-xl font-bold tracking-tight text-brand-text group-hover:text-brand-accent transition-colors">
      <a href={href} class="focus:outline-none">{title}</a>
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-brand-text-muted">
      {description}
    </p>

    <!-- Clear Minimalist Features -->
    <ul class="mt-6 space-y-2 border-t border-brand-border pt-6 text-xs text-brand-text-muted">
      {features.map((feat) => (
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-8 pt-4">
    <a
      href={href}
      class="text-xs font-semibold text-brand-accent hover:text-brand-accent-hover transition-colors inline-flex items-center gap-1.5"
    >
      <span>Read Service Architecture</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>