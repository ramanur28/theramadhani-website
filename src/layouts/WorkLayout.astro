---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import QuickAnswer from '@/components/common/QuickAnswer.astro';
import type { BreadcrumbItem, ArticleSchemaData } from '@/types/schema';

export interface Props {
  title: string;
  client: string;
  industry: string;
  service: string;
  description: string;
  publishDate: Date;
  metrics: { value: string; label: string }[];
  quickAnswer: string;
  techStack: string[];
  coverImage?: string;
  coverAlt?: string;
  slug: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  client,
  industry,
  service,
  description,
  publishDate,
  metrics,
  quickAnswer,
  techStack,
  coverImage,
  coverAlt = 'Case study overview',
  slug,
  headings = [],
} = Astro.props;

const formattedPublishDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Work / Proof', url: '/work' },
  { name: title, url: `/work/${slug}` },
];

const safeCoverImage = coverImage
  ? (coverImage.startsWith('http') || coverImage.startsWith('/') ? coverImage : `/${coverImage}`)
  : null;

const caseStudySchema: ArticleSchemaData = {
  headline: title,
  description: description,
  datePublished: publishDate.toISOString(),
  authorName: 'Ramadhani',
  authorUrl: 'https://ramadhani.dev/about',
  imageUrl: safeCoverImage || 'https://ramadhani.dev/images/brand-logo.svg',
  articleUrl: `https://ramadhani.dev/work/${slug}`,
  keywords: [service, industry, 'Case Study', 'Performance Audit', ...techStack],
};

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} | The Ramadhani Case Study`}
  description={description}
  image={safeCoverImage || undefined}
  article={caseStudySchema}
  breadcrumbs={breadcrumbs}
  type="article"
>
  <article class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <Breadcrumbs items={breadcrumbs} />

      <!-- Client & Service Badges -->
      <div class="flex flex-wrap items-center gap-2 mb-4 animate-hero-entrance">
        <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-md border border-brand-accent/20">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
          {service}
        </span>
        <span class="font-mono text-xs text-brand-text-dim bg-brand-surface border border-brand-border px-2.5 py-1 rounded-md">
          Industry: {industry}
        </span>
      </div>

      <!-- Case Study Title -->
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-brand-text sm:text-4xl lg:text-5xl leading-tight animate-hero-stagger-1">
        {title}
      </h1>

      <!-- Client & Date Row -->
      <div class="mt-3 flex items-center gap-3 text-xs text-brand-text-dim font-mono animate-hero-stagger-2">
        <span>Client: <strong class="text-brand-text font-semibold">{client}</strong></span>
        <span>&bull;</span>
        <time datetime={publishDate.toISOString()}>{formattedPublishDate}</time>
      </div>

      <!-- Optional Cover Banner / Diagram -->
      {safeCoverImage && (
        <figure class="my-8 overflow-hidden rounded-2xl border border-brand-border bg-brand-surface shadow-sm animate-hero-stagger-3 reveal-scale">
          <img
            src={safeCoverImage}
            alt={coverAlt || title}
            width="800"
            height="450"
            class="w-full h-auto aspect-video object-cover"
            loading="eager"
            fetchpriority="high"
          />
          {coverAlt && coverAlt !== 'Case study overview' && (
            <figcaption class="px-4 py-2 text-center font-mono text-[11px] text-brand-text-dim border-t border-brand-border/60 bg-brand-bg/50">
              {coverAlt}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Quick Executive Summary Direct Answer -->
      <div class="mt-8 animate-hero-stagger-3">
        <QuickAnswer answer={quickAnswer} />
      </div>

      <!-- 3 Key Metric Highlights -->
      <div class="my-10 grid grid-cols-1 sm:grid-cols-3 gap-4 reveal-on-scroll reveal-delay-100">
        {metrics.map((m) => (
          <div class="rounded-xl border border-brand-border bg-brand-card p-6 shadow-sm">
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-brand-text">
              {m.value}
            </div>
            <div class="mt-1.5 text-xs font-semibold text-brand-accent">
              {m.label}
            </div>
          </div>
        ))}
      </div>

      <!-- Tech Stack & Tools Used -->
      {techStack && techStack.length > 0 && (
        <div class="mb-10 rounded-xl border border-brand-border bg-brand-surface p-4 flex flex-wrap items-center gap-2 reveal-on-scroll reveal-delay-150">
          <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-brand-text-dim mr-2">
            Architecture &amp; Tooling:
          </span>
          {techStack.map((tech) => (
            <span class="font-mono text-xs font-medium text-brand-text bg-brand-card border border-brand-border px-2.5 py-1 rounded-md shadow-2xs">
              {tech}
            </span>
          ))}
        </div>
      )}

      <!-- Table of Contents -->
      {tocHeadings.length > 0 && (
        <div class="my-10 rounded-xl border border-brand-border bg-brand-card p-6 shadow-sm reveal-on-scroll reveal-delay-200">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-brand-text mb-3">
            Case Study Navigation
          </div>
          <nav aria-label="Table of Contents">
            <ul class="space-y-2 text-xs text-brand-text-muted">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? "ml-3 text-brand-text-dim" : "font-semibold text-brand-text hover:text-brand-accent transition-colors"}>
                  <a href={`#${h.slug}`} class="flex items-center gap-1.5">
                    <span class="text-brand-accent font-bold">&rsaquo;</span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}

      <!-- Main Case Study Content -->
      <div class="prose max-w-none text-base leading-relaxed reveal-on-scroll reveal-delay-200 text-[#374151] prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[#111317] prose-p:text-[#374151] prose-p:leading-relaxed prose-strong:text-[#111317] prose-strong:font-bold prose-li:text-[#374151] prose-a:text-brand-accent prose-a:font-semibold prose-a:underline hover:prose-a:text-brand-accent-hover prose-code:font-mono prose-code:text-brand-accent prose-code:bg-brand-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:border prose-pre:border-brand-border prose-pre:bg-brand-surface prose-pre:text-brand-text prose-blockquote:border-l-brand-accent prose-blockquote:text-brand-text prose-blockquote:bg-brand-surface/70 prose-blockquote:rounded-r-lg prose-blockquote:p-4 prose-th:text-brand-text prose-th:font-bold prose-td:text-brand-text-muted">
        <slot />
      </div>

      <!-- Bottom Strategic Growth CTA -->
      <div class="mt-16 rounded-2xl border border-brand-border bg-brand-surface p-8 sm:p-10 text-center reveal-on-scroll reveal-scale">
        <div class="font-mono text-xs font-semibold text-brand-accent mb-2">
          Replicate These Results
        </div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
          Need similar organic pipeline or ROAS growth?
        </h2>
        <p class="mt-3 text-xs sm:text-sm text-brand-text-muted max-w-xl mx-auto leading-relaxed">
          I personally audit your technical search code, Schema knowledge graph, and paid campaigns, providing an actionable 90-day roadmap within 48 hours.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/contact" class="btn-primary">
            <span>Schedule Strategic Audit</span>
            <span class="ml-1.5">&rarr;</span>
          </a>
          <a href="/work" class="btn-secondary">
            <span>View All Case Studies</span>
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
