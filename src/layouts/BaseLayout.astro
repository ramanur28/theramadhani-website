---
import BaseHead from '@/components/seo/BaseHead.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import type { ServiceSchemaData, ArticleSchemaData, PersonSchemaData, FAQItem, BreadcrumbItem } from '@/types/schema';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: ArticleSchemaData;
  service?: ServiceSchemaData;
  person?: PersonSchemaData;
  faq?: FAQItem[];
  breadcrumbs?: BreadcrumbItem[];
  type?: 'website' | 'article' | 'service' | 'person' | 'about' | 'contact';
}

const {
  title,
  description,
  image,
  article,
  service,
  person,
  faq,
  breadcrumbs,
  type = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      service={service}
      person={person}
      faq={faq}
      breadcrumbs={breadcrumbs}
      type={type}
    />
  </head>
  <body class="flex min-h-screen flex-col bg-brand-bg text-brand-text antialiased selection:bg-brand-accent/20 selection:text-brand-accent">
    <!-- Top Scroll & Navigation Progress Bar -->
    <div id="scroll-progress-bar" aria-hidden="true"></div>

    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll Reveal & Page Lifecycle Animation Script -->
    <script>
      function initScrollReveals() {
        // 1. Scroll Reading Progress Bar
        const progressBar = document.getElementById('scroll-progress-bar');
        const updateScrollProgress = () => {
          if (!progressBar) return;
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const progress = scrollHeight > 0 ? scrollTop / scrollHeight : 0;
          progressBar.style.transform = `scaleX(${progress})`;
        };

        window.addEventListener('scroll', updateScrollProgress, { passive: true });
        updateScrollProgress();

        // 2. IntersectionObserver for Scroll Reveal Elements
        const revealElements = document.querySelectorAll(
          '.reveal-on-scroll, .reveal-fade-left, .reveal-fade-right, .reveal-scale'
        );

        if (!revealElements.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  obs.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: '0px 0px -40px 0px',
            }
          );

          revealElements.forEach((el) => observer.observe(el));
        } else {
          // Fallback for older browsers
          revealElements.forEach((el) => el.classList.add('is-visible'));
        }
      }

      // Initialize on first DOM load and on every Astro View Transition page load
      initScrollReveals();
      document.addEventListener('astro:page-load', initScrollReveals);
    </script>
  </body>
</html>
