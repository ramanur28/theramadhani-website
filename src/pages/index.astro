  <!-- Dynamic Desktop-Only Video Streaming Script -->
  <script is:inline>
    function initDesktopHeroVideo() {
      if (window.innerWidth < 768) return;
      const mount = document.getElementById('desktop-hero-video-container');
      if (!mount || mount.querySelector('video')) return;

      const video = document.createElement('video');
      video.autoplay = true;
      video.loop = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';
      video.poster = '/images/hero-poster.webp';
      video.className = 'w-full h-full object-cover';

      const src = document.createElement('source');
      src.src = '/videos/hero-bg-video.mp4';
      src.type = 'video/mp4';
      video.appendChild(src);
      mount.appendChild(video);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDesktopHeroVideo);
    } else {
      initDesktopHeroVideo();
    }
    document.addEventListener('astro:page-load', initDesktopHeroVideo);
  </script>
</BaseLayout>
