---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { isArticlePublished } from '@/utils/articles';
import type { FAQItem } from '@/types/schema';

export async function getStaticPaths() {
  const articles = await getCollection('articles', isArticlePublished);
  const sorted = [...articles].sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );

  return sorted.map((article, idx) => {
    const currentSlug = article.data.slug || article.id;
    const currentTags = new Set(article.data.tags.map((t) => t.toLowerCase()));

    // Score other articles by tag overlap + deterministic circular neighbors so every article gets incoming links
    const candidates = sorted
      .filter((other) => (other.data.slug || other.id) !== currentSlug)
      .map((other, otherIdx) => {
        const overlap = other.data.tags.filter((t) => currentTags.has(t.toLowerCase())).length;
        const circularDist = (otherIdx - idx + sorted.length) % sorted.length;
        return {
          other,
          score: overlap * 10 + (circularDist <= 2 ? 5 : 0),
        };
      })
      .sort((a, b) => b.score - a.score)
      .slice(0, 4)
      .map(({ other }) => ({
        title: other.data.title,
        description: other.data.description,
        slug: other.data.slug || other.id,
        tags: other.data.tags,
        publishDate: other.data.publishDate,
      }));

    return {
      params: { slug: currentSlug },
      props: { article, relatedArticles: candidates },
    };
  });
}

const { article, relatedArticles = [] } = Astro.props;
const { Content, headings } = await render(article);

const primaryTag = article.data.tags[0] || 'Technical SEO';
const secondaryTag = article.data.tags[1] || 'Organic Search Growth';

// Custom FAQ from frontmatter if provided, otherwise topic-specific contextual FAQs
const defaultFaqData: FAQItem[] = [
  {
    question: `What is the executive summary of "${article.data.title}"?`,
    answer: article.data.quickAnswer,
  },
  {
    question: `Why is ${primaryTag} critical for ${secondaryTag} and search visibility?`,
    answer: `${article.data.description} Aligning ${primaryTag} with clean site architecture and measurable conversion pathways ensures sustainable organic pipeline growth.`,
  },
];

const faqData: FAQItem[] = article.data.faq && article.data.faq.length > 0
  ? article.data.faq
  : defaultFaqData;
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  publishDate={article.data.publishDate}
  updatedDate={article.data.updatedDate}
  author={article.data.author}
  tags={article.data.tags}
  coverImage={article.data.coverImage}
  coverAlt={article.data.coverAlt}
  quickAnswer={article.data.quickAnswer}
  slug={article.data.slug || article.id}
  faq={faqData}
  headings={headings}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
