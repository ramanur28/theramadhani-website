---
import PageLayout from '@/layouts/PageLayout.astro';
import ArticleFilter from '@/components/islands/ArticleFilter.tsx';
import { getCollection } from 'astro:content';
import type { BreadcrumbItem } from '@/types/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Articles', url: '/articles' },
];

const articles = await getCollection('articles');

const formattedArticles = articles
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .map((art) => ({
    id: art.id,
    slug: art.data.slug || art.id,
    title: art.data.title,
    description: art.data.description,
    publishDate: art.data.publishDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
    author: art.data.author,
    tags: art.data.tags,
    coverImage: art.data.coverImage,
    coverAlt: art.data.coverAlt,
    quickAnswer: art.data.quickAnswer,
  }));

const allTags = Array.from(new Set(articles.flatMap((a) => a.data.tags)));
---

<PageLayout
  title="Publications & Technical Guides | The Ramadhani"
  description="In-depth articles, frameworks, and actionable guides on Technical SEO, Generative Engine Optimization (GEO), and Google Ads."
  headline="Search Architecture, GEO & Acquisition Insights."
  subheadline="Actionable, machine-dense publications designed for engineering leaders and AI answer engine extraction."
  badge="Publications"
  breadcrumbs={breadcrumbs}
  type="website"
>
  <ArticleFilter client:visible articles={formattedArticles} allTags={allTags} />
</PageLayout>