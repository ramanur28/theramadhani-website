# ==============================================================================
# Docker Ignore Configuration for Optimized & Secure Multi-Stage Builds
# ==============================================================================

# Version Control
.git
.gitignore
.github

# Node Dependencies (freshly installed in Docker container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build Outputs & Astro Cache (built freshly during Docker build)
dist
.astro

# Sensitive Credentials & Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key

# Documentation & Markdown Files
DEPLOY.md
README.md
*.md

# Operating System & IDE Files
.DS_Store
Thumbs.db
Desktop.ini
*Zone.Identifier
*.Zone.Identifier
.vscode
.idea
*.swp
*.swo

# Docker Compose Specifications
docker-compose*.yml

# Lighthouse & Testing Artifacts
.lighthouseci
coverage

# Temporary files & root duplicates
scratch
Hero-bg-video.mp4
