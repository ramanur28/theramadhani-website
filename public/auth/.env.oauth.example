# GitHub OAuth App Credentials for Decap CMS
# Buat OAuth App di: https://github.com/settings/developers
# - Application name: The Ramadhani CMS
# - Homepage URL: https://theramadhani.com (atau domain shared hosting Anda)
# - Authorization callback URL: https://theramadhani.com/callback

OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id_here
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
SITE_URL=https://theramadhani.com
