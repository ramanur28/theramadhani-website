# ==============================================================================
# The Ramadhani - Shared Hosting Production Apache / LiteSpeed Configuration
# Optimized for Astro Static Generation + Decap CMS PHP OAuth (cPanel / LiteSpeed)
# ==============================================================================

# Ensure index.html takes precedence over index.php for static routes
DirectoryIndex index.html index.php

# Prevent MultiViews conflicts (cPanel default) and directory browsing
Options -MultiViews -Indexes +FollowSymLinks

# ------------------------------------------------------------------------------
# 1. Explicit MIME Types (Ensures correct headers on all shared hosting setups)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/html .html .htm
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/json .json
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/xml .xml
</IfModule>

# ------------------------------------------------------------------------------
# 2. Core Engine & Rewrite Settings
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Exclude cPanel AutoSSL & Let's Encrypt challenges from rewrites
    RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
    RewriteRule ^ - [L]

    # Force HTTPS (Preserve SSL)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove www (canonicalize to apex domain)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Route /sitemap.xml to /sitemap-index.xml (Astro sitemap index)
    RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

    # Fallback for relative image paths under /admin/
    RewriteRule ^admin/images/uploads/(.*)$ /images/uploads/$1 [L,R=301]

    # Direct OAuth Handlers for Decap CMS
    RewriteRule ^auth/?$ /auth/index.php [L,QSA]
    RewriteRule ^callback/?$ /callback/index.php [L,QSA]

    # Contact Form API Handler
    RewriteRule ^api/contact/?$ /api/contact.php [L,QSA]

    # Clean URLs & Directory Slashing for Astro Static Files
    # If request is an existing directory and missing trailing slash, redirect with slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

    # Serve index.html inside directory if exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # Custom Branded 404 Error Document
    ErrorDocument 404 /404.html
</IfModule>

# ------------------------------------------------------------------------------
# 3. Production Security & Caching Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # HTTP Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking Protection (Allow Decap CMS popups / same origin iframes)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Feature & Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Revalidation for HTML, XML, YAML, and Decap CMS config & preview
    <FilesMatch "\.(html|htm|xml|txt|yml|yaml|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Never cache Decap CMS admin live preview scripts & styling with immutable
    <FilesMatch "^(preview\.(js|css)|config\.yml)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Standard browser caching for unhashed static assets (images, fonts)
    <FilesMatch "\.(woff|woff2|ttf|eot|webp|avif|png|jpg|jpeg|svg|ico|mp4)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Fingerprinted / Hashed Assets generated by Astro (safe for immutable 1-year cache)
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# ------------------------------------------------------------------------------
# 4. Leverage Browser Caching (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Dynamic & Content Directives (Always revalidate HTML/XML/YAML)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xhtml+xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType text/yaml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # Static Fingerprinted & Media Assets
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Gzip / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Security & Sensitive Files Protection (Apache 2.4 & 2.2 Dual Compatible)
# ------------------------------------------------------------------------------
# Prevent access to dotfiles (.env, .git, .htaccess, .env.oauth, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent direct web access to internal PHP configuration file
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
