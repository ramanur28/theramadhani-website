# ==============================================================================
# Ramadhani Personal Brand Website - Environment Configuration
# Copy this file to .env before starting the production stack: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & URL Configuration
# ------------------------------------------------------------------------------
# Primary domain for Caddy automated HTTPS certificate provisioning
WEB_IMAGE=ramadhani-web:latest
SITE_DOMAIN=ramadhani.cloud

# Canonical base URL for SEO tags, OpenGraph, RSS, and Sitemap generation
SITE_URL=https://ramadhani.cloud

# ------------------------------------------------------------------------------
# 2. Self-Hosted Umami Analytics Database Credentials
# ------------------------------------------------------------------------------
UMAMI_DB_NAME=umami_analytics
UMAMI_DB_USER=umami_admin
# Use a strong, random password in production
UMAMI_DB_PASSWORD=change_this_to_a_secure_postgres_password

# A random 32+ character string used as a salt for hashing in Umami
UMAMI_APP_SECRET=generate_random_32_character_string_here_abc123

# ------------------------------------------------------------------------------
# 3. Decap CMS (GitHub OAuth Backend)
# ------------------------------------------------------------------------------
# Register GitHub OAuth App at https://github.com/settings/developers
# - Homepage URL: https://ramadhani.cloud
# - Authorization callback URL: https://ramadhani.cloud/callback?provider=github
OAUTH_CLIENT_ID=your_github_oauth_app_client_id
OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret

# ------------------------------------------------------------------------------
# 4. Contact Form & Webhook Notifications
# ------------------------------------------------------------------------------
CONTACT_FORM_ENDPOINT=https://api.ramadhani.cloud/contact
CONTACT_EMAIL_NOTIFICATION=contact@ramadhani.cloud

# ------------------------------------------------------------------------------
# 5. Automated Build Webhook Secret
# ------------------------------------------------------------------------------
# Secret token used by the webhook listener to trigger `docker compose build` on CMS publish
REBUILD_WEBHOOK_SECRET=your_super_secret_rebuild_token_here
# ------------------------------------------------------------------------------
# 6. Umami Tracking & Heatmap Configuration
# ------------------------------------------------------------------------------
PUBLIC_UMAMI_WEBSITE_ID=1caa2dcc-1a6e-4727-be26-0f3e6dc7c05b
PUBLIC_UMAMI_HOST_URL=https://analytics.ramadhani.cloud
